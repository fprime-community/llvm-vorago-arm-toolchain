; Test v2i16 addition using UADD16 instruction
define void @test_v2i16_add(ptr %a, ptr %b, ptr %result) {
; CHECK-LABEL: test_v2i16_add:
; CHECK:       @ %bb.0:
; CHECK:         ldr {{r[0-9]+}}, [{{r[0-9]+}}]
; CHECK:         ldr {{r[0-9]+}}, [{{r[0-9]+}}]
; CHECK:         uadd16 {{r[0-9]+}}, {{r[0-9]+}}, {{r[0-9]+}}
; CHECK:         str {{r[0-9]+}}, [{{r[0-9]+}}]
; CHECK:         bx lr
entry:
  %a_vec = load <2 x i16>, ptr %a, align 4
  %b_vec = load <2 x i16>, ptr %b, align 4
  %sum = add <2 x i16> %a_vec, %b_vec
  store <2 x i16> %sum, ptr %result, align 4
  ret void
}

