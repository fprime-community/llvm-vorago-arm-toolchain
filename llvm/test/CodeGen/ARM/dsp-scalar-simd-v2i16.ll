; Test BUILD_VECTOR with all constant values
define void @test_build_vector_const(ptr %result) {
; CHECK-LABEL: test_build_vector_const:
; CHECK:       @ %bb.0:
; CHECK:         movs {{r[0-9]+}}, #{{[0-9]+}}
; CHECK:         movt {{r[0-9]+}}, #{{[0-9]+}}
; CHECK:         str {{r[0-9]+}}, [{{r[0-9]+}}]
; CHECK:         bx lr
entry:
  ; Creates vector [1, 2] = 0x00020001
  %vec = insertelement <2 x i16> undef, i16 1, i32 0
  %vec1 = insertelement <2 x i16> %vec, i16 2, i32 1
  store <2 x i16> %vec1, ptr %result, align 4
  ret void
}

