; Test v4i8 addition using UADD8 instruction
define void @test_v4i8_add(ptr %a, ptr %b, ptr %result) {
; CHECK-LABEL: test_v4i8_add:
; CHECK:       @ %bb.0:
; CHECK:         ldr {{r[0-9]+}}, [{{r[0-9]+}}]
; CHECK:         ldr {{r[0-9]+}}, [{{r[0-9]+}}]
; CHECK:         uadd8 {{r[0-9]+}}, {{r[0-9]+}}, {{r[0-9]+}}
; CHECK:         str {{r[0-9]+}}, [{{r[0-9]+}}]
; CHECK:         bx lr
entry:
  %a_vec = load <4 x i8>, ptr %a, align 4
  %b_vec = load <4 x i8>, ptr %b, align 4
  %sum = add <4 x i8> %a_vec, %b_vec
  store <4 x i8> %sum, ptr %result, align 4
  ret void
}

