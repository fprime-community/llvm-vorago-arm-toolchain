; Test BUILD_VECTOR with all constant values
define void @test_build_vector_const(ptr %result) {
; CHECK-LABEL: test_build_vector_const:
; CHECK:       @ %bb.0:
; CHECK:         movw {{r[0-9]+}}, #513
; CHECK:         movt {{r[0-9]+}}, #1027
; CHECK:         str {{r[0-9]+}}, [{{r[0-9]+}}]
; CHECK:         bx lr
entry:
  ; Creates vector [1, 2, 3, 4] = 0x04030201
  %vec = insertelement <4 x i8> undef, i8 1, i32 0
  %vec1 = insertelement <4 x i8> %vec, i8 2, i32 1
  %vec2 = insertelement <4 x i8> %vec1, i8 3, i32 2
  %vec3 = insertelement <4 x i8> %vec2, i8 4, i32 3
  store <4 x i8> %vec3, ptr %result, align 4
  ret void
}

